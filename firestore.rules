rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.participants;
    }

    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'username',
          'usernameLower',
          'createdAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.username.matches('^[A-Za-z0-9._-]+$')
        && request.resource.data.usernameLower is string
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)
        ).data.uid == userId;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username',
          'usernameLower'
        ])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.username.matches('^[A-Za-z0-9._-]+$')
        && request.resource.data.usernameLower is string
        && getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)
        ).data.uid == userId
        && getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)
        ).data.username == request.resource.data.username;

      allow delete: if false;
    }

    match /usernames/{usernameLower} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.usernameLower == usernameLower
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.username == request.resource.data.username;

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.usernameLower != usernameLower;
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participants',
          'participantNames',
          'lastMessage',
          'lastSenderId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participantNames is map
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastSenderId == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage',
              'lastSenderId',
              'updatedAt'
            ])
            && request.resource.data.participants == resource.data.participants
            && request.resource.data.participantNames == resource.data.participantNames
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessage.size() <= 500
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.updatedAt == request.time
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'participantNames'
            ])
            && request.resource.data.participantNames
              .diff(resource.data.participantNames)
              .affectedKeys()
              .hasOnly([request.auth.uid])
            && request.resource.data.participantNames[request.auth.uid]
              == get(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.username
          )
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId)
          && request.resource.data.keys().hasOnly([
            'text',
            'senderId',
            'senderName',
            'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName
            == get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.username
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
